# FlowFetch Next Backend — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS & Security (comma-separated origins, or * for public access)
ALLOWED_ORIGINS=http://localhost:5173

# Concurrency & Rate Limiting
MAX_CONCURRENT_JOBS=3
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Timeouts (in milliseconds)
ANALYZE_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=300000

# Optional Path & Extractor Overrides (leave commented out to use system defaults)
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# TMP_DIR=
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=android,web
