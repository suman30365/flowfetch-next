# FlowFetch Next Frontend — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Optional Backend API Base URL
# In local development with Vite proxy, leave this blank.
# In production with separate frontend/backend deployments (e.g. Vercel + Render):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
VITE_API_BASE_URL=
